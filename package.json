{
  "name": "heel",
  "version": "0.1.0",
  "description": "A self-hosted gateway that holds every agent credential and decides each call with default-deny rules.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26.13.0"
  },
  "bin": {
    "heel": "./bin/heel.js"
  },
  "scripts": {
    "heel": "node ./bin/heel.js",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:invariants": "node ./scripts/check-invariants.ts",
    "db:generate": "drizzle-kit generate",
    "db:drift": "node ./scripts/check-migration-drift.ts",
    "ui:preview": "node ./scripts/ui-preview.ts",
    "gen:schema": "node ./scripts/gen-rules-schema.ts",
    "schema:drift": "node ./scripts/gen-rules-schema.ts --check",
    "gen:looks-like": "node ./scripts/gen-looks-like.ts",
    "eval:looks-like": "node ./scripts/eval-looks-like.ts",
    "gen:cli-tables": "node ./scripts/gen-cli-tables.ts"
  },
  "dependencies": {
    "@hono/node-server": "~2.1.8",
    "@simplewebauthn/server": "~14.1.0",
    "@slack/web-api": "~8.3.0",
    "better-sqlite3": "~13.1.1",
    "drizzle-orm": "~0.45.4",
    "hono": "~4.13.18",
    "nodemailer": "~10.5.0",
    "openid-client": "~6.8.9",
    "pino": "~10.4.0",
    "re2js": "~2.10.0",
    "web-push": "~4.0.0",
    "yaml": "~2.9.1",
    "zod": "~4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "~2.6.7",
    "@playwright/test": "~1.65.0",
    "@types/better-sqlite3": "~9.6.0",
    "@types/node": "~26.6.6",
    "drizzle-kit": "~0.31.11",
    "fast-check": "~4.10.2",
    "linkedom": "~0.18.15",
    "typescript": "~7.0.2",
    "vitest": "~5.1.0"
  }
}
