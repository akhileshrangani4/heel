      "compositePrimaryKeys": {},
      "uniqueConstraints": {},
      "checkConstraints": {
        "audit_log_kind": {
          "name": "audit_log_kind",
          "value": "\"kind\" IN ('allow', 'deny', 'ask', 'paused', 'expired', 'approved', 'approval_denied', 'executed')"
        },
        "audit_log_pause_scope": {
          "name": "audit_log_pause_scope",
          "value": "\"pause_scope\" IS NULL OR \"pause_scope\" IN ('global', 'agent', 'account', 'provider')"
        },
        "audit_log_args_json": {
          "name": "audit_log_args_json",
          "value": "json_valid(\"args\")"
        },
        "audit_log_complete": {
          "name": "audit_log_complete",
          "value": "CASE \"kind\"\n        WHEN 'allow' THEN \"rule\" IS NOT NULL\n        WHEN 'deny' THEN \"reason\" IS NOT NULL\n        WHEN 'ask' THEN \"rule\" IS NOT NULL AND \"approval_id\" IS NOT NULL\n        WHEN 'paused' THEN \"pause_scope\" IS NOT NULL\n        WHEN 'expired' THEN \"approval_id\" IS NOT NULL\n        WHEN 'approved' THEN \"approval_id\" IS NOT NULL AND \"approver_id\" IS NOT NULL\n        WHEN 'approval_denied' THEN \"approval_id\" IS NOT NULL AND \"approver_id\" IS NOT NULL\n        WHEN 'executed' THEN \"approval_id\" IS NOT NULL\n        ELSE 0\n      END"
        }
      }
    },
